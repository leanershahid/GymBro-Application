# Local secrets for the GymBro API. Git-ignored — never commit this file.
# Names use ASP.NET's double underscore: Storage__CloudinaryApiKey fills Storage:CloudinaryApiKey.
# On Render, set the same names as environment variables instead.

# Cloudinary (file uploads: logos, photos, documents, videos)
Storage__CloudinaryCloudName=your-cloud-name
Storage__CloudinaryApiKey=
Storage__CloudinaryApiSecret=
Storage__CloudinaryRootFolder=gymbro
