{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "GymManagmentApplication",
    "Audience": "GymManagmentApplication",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://gym-bro-uat.vercel.app"
    ]
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "no-reply@gymbro.app",
    "FromName": "GymBro",
    "EnableSsl": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Secrets": {
    "Key": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true,
    "EnableRetryOnFailure": false
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "RateLimits": {
    "GlobalPerMinute": 0
  },
  "Validation": {
    "Mode": "Enforce"
  },
  "Sso": {
    "Enabled": false
  },
  "Push": {
    "ExpoAccessToken": ""
  },
  "Storage": {
    "CloudinaryCloudName": "",
    "CloudinaryApiKey": "",
    "CloudinaryApiSecret": "",
    "CloudinaryRootFolder": "gymbro",
    "SupabaseUrl": "",
    "ServiceKey": "",
    "Bucket": "gymbro",
    "PrivateDocuments": false,
    "SignedUrlMinutes": 10
  }
}
